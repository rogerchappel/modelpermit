{
  "name": "modelpermit",
  "version": "0.1.0",
  "description": "Local-first model and provider permission policy checker for agent workflows.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "fixtures",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "test": "node --test",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:readiness": "node scripts/check-release-install.mjs",
    "release:check": "npm run release:readiness && npm run build && npm test && npm run smoke && npm run package:smoke",
    "build": "node --check src/index.js && node --check src/cli.js",
    "smoke": "bash scripts/smoke.sh && node src/cli.js check fixtures/strict.json && node src/cli.js check fixtures/dangerous.json --json"
  },
  "keywords": [
    "agents",
    "model-policy",
    "permissions",
    "release-readiness",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/modelpermit.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/modelpermit/issues"
  },
  "homepage": "https://github.com/rogerchappel/modelpermit#readme",
  "bin": {
    "modelpermit": "./src/cli.js"
  }
}
