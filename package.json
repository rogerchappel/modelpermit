{
  "name": "modelpermit",
  "version": "0.1.0",
  "description": "modelpermit is an early-stage local-first developer tool.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "test": "node --test",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run build && npm test && npm run smoke && npm run package:smoke",
    "build": "node --check src/index.js && node --check src/cli.js",
    "smoke": "bash scripts/smoke.sh"
  },
  "keywords": [],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/modelpermit.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/modelpermit/issues"
  },
  "homepage": "https://github.com/rogerchappel/modelpermit#readme",
  "bin": {
    "modelpermit": "./src/cli.js"
  }
}
